#!/bin/sh
# deck-backlight-setup: run as root at boot by deck-backlight.service.
# The Waveshare panel's backlight PWM pad is wired to GPIO 18, which is RP1 PWM0 channel 2
# (needs dtoverlay=pwm,pin=18,func=2 in /boot/firmware/config.txt). The panel input is active low,
# so the channel runs with inversed polarity and the duty cycle is the brightness. This exports the channel,
# restores the level saved by ~/bin/deck-brightness and lets the video group change it.
PERIOD=1000000          # ns (1 kHz); deck-brightness keeps whatever period is set here
SAVED=/home/admin/.local/state/deck/brightness

chip=""
for i in $(seq 50); do
  for c in /sys/class/pwm/pwmchip*; do
    case $(readlink -f "$c/device") in *1f00098000.pwm) chip=$c ;; esac
  done
  [ -n "$chip" ] && break
  sleep 0.1
done
[ -n "$chip" ] || { echo "RP1 PWM0 not found: is dtoverlay=pwm,pin=18,func=2 in config.txt?" >&2; exit 1; }

p=$chip/pwm2
[ -d "$p" ] || echo 2 > "$chip/export"
for i in $(seq 50); do [ -e "$p/duty_cycle" ] && break; sleep 0.1; done

level=$(head -c 4 "$SAVED" 2>/dev/null | tr -cd 0-9)
{ [ -n "$level" ] && [ "$level" -ge 5 ] && [ "$level" -le 100 ]; } || level=100

echo 0 > "$p/enable"                # polarity can only change while the channel is off
echo inversed > "$p/polarity"       # the panel dims while the pad is high; a low pin (before boot) is full light
echo 0 > "$p/duty_cycle"            # the duty may never exceed the period, even briefly
echo "$PERIOD" > "$p/period"
echo $((PERIOD / 100 * level)) > "$p/duty_cycle"
echo 1 > "$p/enable"
chgrp video "$p/period" "$p/duty_cycle" "$p/enable"
chmod g+w "$p/period" "$p/duty_cycle" "$p/enable"
