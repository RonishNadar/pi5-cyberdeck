# Deck kiosk: one fullscreen foot terminal, nothing else
# Displays, matched by name or model. The Waveshare 5.5" has no EDID, so the
# kernel cmdline forces ours on HDMI-A-1 (use the other port for other panels).
output * bg #282a36 solid_color
output HDMI-A-1 mode 1440x2560@50Hz transform 270
output "MPI MPI7002 MPI7002" mode 1024x600@60Hz transform normal

# Ring cursor, hidden after 5 seconds without use
seat seat0 xcursor_theme DeckCircle 96
seat seat0 hide_cursor 500

default_border none
default_floating_border none
gaps inner 0
gaps outer 0
focus_follows_mouse no
xwayland disable

exec ~/bin/deck-session.sh
# >>> deck media keys
bindsym --no-repeat F2 exec ~/bin/deck-media.sh home
bindsym --no-repeat XF86HomePage exec ~/bin/deck-media.sh home
bindsym --no-repeat F3 exec ~/bin/deck-media.sh mute
bindsym --no-repeat XF86AudioMute exec ~/bin/deck-media.sh mute
bindsym F4 exec ~/bin/deck-media.sh down
bindsym XF86AudioLowerVolume exec ~/bin/deck-media.sh down
bindsym F5 exec ~/bin/deck-media.sh up
bindsym XF86AudioRaiseVolume exec ~/bin/deck-media.sh up
bindsym --no-repeat F6 exec ~/bin/deck-media.sh prev
bindsym --no-repeat XF86AudioPrev exec ~/bin/deck-media.sh prev
bindsym --no-repeat F7 exec ~/bin/deck-media.sh play
bindsym --no-repeat XF86AudioPlay exec ~/bin/deck-media.sh play
bindsym --no-repeat XF86AudioPause exec ~/bin/deck-media.sh play
bindsym --no-repeat F8 exec ~/bin/deck-media.sh next
bindsym --no-repeat XF86AudioNext exec ~/bin/deck-media.sh next
bindsym --no-repeat XF86Back exec ~/bin/deck-close.sh
bindsym F11 exec ~/bin/deck-brightness down
bindsym XF86MonBrightnessDown exec ~/bin/deck-brightness down
bindsym F12 exec ~/bin/deck-brightness up
bindsym XF86MonBrightnessUp exec ~/bin/deck-brightness up
# <<< deck media keys
