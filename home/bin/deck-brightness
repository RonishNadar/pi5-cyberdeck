#!/usr/bin/env bash
# deck-brightness: Waveshare backlight over PWM on GPIO 18 (RP1 PWM0 channel 2).
#   deck-brightness           print the level in percent
#   deck-brightness 40        set 40%
#   deck-brightness +10|-10   step up or down
#   deck-brightness up|down   step by 10 and show the level in a tmux banner (sway keys)
# The level is saved in ~/.local/state/deck/brightness. deck-backlight.service
# (/usr/local/bin/deck-backlight-setup) restores it at boot and makes the PWM files writable
# for the video group. Prints nothing and exits 1 when the PWM channel is not set up.
# Tests: DECK_BRIGHTNESS_PWM=<dir with period, duty_cycle> DECK_BRIGHTNESS_STATE=<scratch file>
MIN=5; STEP=10
STATE=${DECK_BRIGHTNESS_STATE:-$HOME/.local/state/deck/brightness}
PWM=$DECK_BRIGHTNESS_PWM
if [ -z "$PWM" ]; then
  for c in /sys/class/pwm/pwmchip*; do
    [[ $(readlink -f "$c/device") == *1f00098000.pwm ]] && PWM=$c/pwm2
  done
fi
[ -n "$PWM" ] && [ -w "$PWM/duty_cycle" ] || exit 1

period=$(<"$PWM/period")
[ "$period" -gt 0 ] 2>/dev/null || exit 1
cur=$(( ($(<"$PWM/duty_cycle") * 100 + period / 2) / period ))

case "${1:-}" in
  "")          echo "$cur"; exit 0 ;;
  up|down)     banner=1; [ "$1" = up ] && arg=+$STEP || arg=-$STEP ;;
  *)           arg=$1 ;;
esac

[[ $arg =~ ^[+-]?[0-9]{1,3}$ ]] || { echo "usage: deck-brightness [PERCENT|+N|-N|up|down]" >&2; exit 2; }
case "$arg" in
  +*)  new=$(( cur / STEP * STEP + 10#${arg#+} )) ;;                # snap to the step grid
  -*)  new=$(( (cur + STEP - 1) / STEP * STEP - 10#${arg#-} )) ;;
  *)   new=$(( 10#$arg )) ;;
esac
(( new < MIN )) && new=$MIN
(( new > 100 )) && new=100

echo $(( period / 100 * new )) > "$PWM/duty_cycle"
mkdir -p "$(dirname "$STATE")" && echo "$new" > "$STATE"
[ -n "${banner:-}" ] && tmux display-message -d 1200 "Brightness $new%" 2>/dev/null
echo "$new"
